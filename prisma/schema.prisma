// RechargeGuard — recharge reminder app
// Run `npx prisma generate` after cloning, and `npx prisma migrate dev` to create tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  telegramChatId String?
  defaultLeadDays Int     @default(3)
  createdAt      DateTime @default(now())

  recharges         RechargeItem[]
  pushSubscriptions PushSubscription[]
  analyticsEvents   AnalyticsEvent[]
  reminders         Reminder[]

  @@map("users")
}

enum RechargeType {
  MOBILE
  BROADBAND
  OTHER
}

model RechargeItem {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  label         String       // "Papa", "Wife", "Home Fiber"
  provider      String       // "Jio", "Airtel", "Vi", "JioFiber"
  type          RechargeType @default(MOBILE)
  phone         String?
  amount        Int          // amount in paise, e.g. 23900 for ₹239.00
  cycleDays     Int          // 28, 30, 84, 365
  lastRecharge  DateTime
  leadDays      Int          @default(3) // remind this many days before due
  lastNotifiedFor DateTime?  // due-date instance we already notified for (idempotency)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("recharge_items")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

// First-party, cookieless analytics. `visitorId` is a daily-rotating HMAC of
// IP + user-agent (the raw IP / UA are never stored), so it can count unique
// visitors per day but cannot follow anyone across days. `userId` is set when
// the person is signed in, and becomes NULL if the account is deleted.
model AnalyticsEvent {
  id          String   @id @default(cuid())
  name        String   // page_view, cta_click, signup, login, recharge_created, ...
  path        String?
  label       String?  // e.g. which CTA was clicked
  visitorId   String?
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  referrer    String?  // hostname only
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  country     String?
  device      String?  // mobile | tablet | desktop
  createdAt   DateTime @default(now())

  @@index([name, createdAt])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("analytics_events")
}

// A simple day-based note-style reminder ("renew car insurance", "change AC
// filter"). Same idea as a recharge item, minus provider/amount: one due date,
// optionally repeating every `repeatDays`. `repeatDays = null` means one-time,
// and marking it done sets `completedAt`.
model Reminder {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  note            String?
  dueDate         DateTime
  repeatDays      Int?
  leadDays        Int       @default(3)
  lastNotifiedFor DateTime? // idempotency marker for the daily cron
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([completedAt, dueDate])
  @@map("reminders")
}

// Fixed-window counters for login / signup rate limiting (see lib/rateLimit.ts).
model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
  @@map("rate_limits")
}