// RechargeGuard — recharge reminder app
// Run `npx prisma generate` after cloning, and `npx prisma migrate dev` to create tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  telegramChatId String?
  defaultLeadDays Int     @default(3)
  createdAt      DateTime @default(now())

  recharges         RechargeItem[]
  pushSubscriptions PushSubscription[]

  @@map("users")
}

enum RechargeType {
  MOBILE
  BROADBAND
  OTHER
}

model RechargeItem {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  label         String       // "Papa", "Wife", "Home Fiber"
  provider      String       // "Jio", "Airtel", "Vi", "JioFiber"
  type          RechargeType @default(MOBILE)
  phone         String?
  amount        Int          // amount in paise, e.g. 23900 for ₹239.00
  cycleDays     Int          // 28, 30, 84, 365
  lastRecharge  DateTime
  leadDays      Int          @default(3) // remind this many days before due
  lastNotifiedFor DateTime?  // due-date instance we already notified for (idempotency)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("recharge_items")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}
