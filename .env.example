# Postgres connection string (Neon pooled connection recommended).
# Used for both the app runtime and `prisma migrate`/`db push` — this schema
# doesn't split pooled/direct URLs, so one value covers both.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# REQUIRED in production, at least 32 characters (the app refuses to start
# otherwise). Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact address push services can use if your sends misbehave.
VAPID_SUBJECT="mailto:you@example.com"

PUBLIC_APP_URL="https://demo.vercel.app"

# Message @BotFather on Telegram, /newbot, copy the token it gives you.
TELEGRAM_BOT_TOKEN=""
# Non-guessable URL segment for the Telegram webhook endpoint.
TELEGRAM_WEBHOOK_SECRET=""
# Secret value configured with Telegram setWebhook; sent in the request header.
TELEGRAM_WEBHOOK_HEADER_SECRET=""

# REQUIRED. Sent as a Bearer token by Vercel Cron to authorize calls to
# /api/cron/check-reminders (the route rejects everything if this is unset).
# Generate with: openssl rand -hex 32
CRON_SECRET="change-me"

# Analytics
# Google Analytics 4 measurement ID (looks like G-XXXXXXXXXX). Leave empty to
# disable GA. NEXT_PUBLIC_* values are inlined at build time, so redeploy
# after changing it.
NEXT_PUBLIC_GA_ID=""
# Comma-separated emails allowed to open /admin (the first-party analytics page).
ADMIN_EMAILS="you@example.com"
# Optional: secret used to hash anonymous visitor ids. Falls back to AUTH_SECRET.
ANALYTICS_SALT=""